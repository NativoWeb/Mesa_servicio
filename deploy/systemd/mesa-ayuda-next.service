[Unit]
Description=Mesa de Ayuda UTS - frontend Next.js (next start)
After=network.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/var/www/mesa-ayuda/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
